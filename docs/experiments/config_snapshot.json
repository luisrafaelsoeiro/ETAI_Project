      "spend_365d"
    ],
    "categorical_features": [
      "payment_type",
      "salesperson",
      "commercial_zone",
      "transport_method",
      "warehouse",
      "document_series"
    ],
    "flag_features": [
      "is_first_purchase",
      "has_gap_history"
    ],
    "mnar_indicator_sources": [
      "spend_365d"
    ],
    "imputation": {
      "numeric_strategy": "median",
      "categorical_strategy": "most_frequent",
      "fit_rows": {
        "spend_365d": "prior_purchase_count > 0",
        "prior_max_purchase_value": "prior_purchase_count > 0"
      },
      "column_imputers": {},
      "row_bounds": {
        "prior_max_purchase_value": {
          "min": [
            "prior_mean_purchase_value",
            "spend_365d / purchase_count_365d",
            "(spend_365d - spend_180d) / (purchase_count_365d - purchase_count_180d)",
            "(prior_total_spend - spend_365d) / (prior_purchase_count - purchase_count_365d)"
          ],
          "max": [
            "prior_total_spend - (prior_purchase_count - 1) * prior_min_purchase_value",
            "prior_mean_purchase_value + prior_std_purchase_value * sqrt(abs(prior_purchase_count - 1))"
          ]
        },
        "spend_365d": {
          "min": [
            "spend_180d",
            "purchase_count_365d * prior_min_purchase_value",
            "spend_180d + (purchase_count_365d - purchase_count_180d) * prior_min_purchase_value",
            "prior_total_spend - (prior_purchase_count - purchase_count_365d) * prior_max_purchase_value"
          ],
          "max": [
            "prior_total_spend",
            "purchase_count_365d * prior_max_purchase_value",
            "spend_180d + (purchase_count_365d - purchase_count_180d) * prior_max_purchase_value",
            "prior_total_spend - (prior_purchase_count - purchase_count_365d) * prior_min_purchase_value"
          ]
        },
        "days_since_previous_purchase": {
          "max": "customer_tenure_days"
        },
        "prior_mean_gap_days": {
          "max": "customer_tenure_days"
        }
      }
    },
    "rare_category_min_count": 0,
    "encoder": "target",
    "scaler": "robust",
    "exclude_features": [
      "global_discount_total",
      "commercial_zone",
      "warehouse"
    ],
    "selection": {
      "method": "none"
    },
    "random_state": 42
  },
  "classification": {
    "target": "repeat_purchase_90d",
    "metrics": [
