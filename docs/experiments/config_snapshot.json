        "params": {
          "n_estimators": 300,
          "min_samples_leaf": 5,
          "n_jobs": -1,
          "random_state": 42
        }
      }
    ],
    "preprocessing": {
      "encoder": "target",
      "scaler": "standard",
      "exclude_features": [
        "document_series",
        "shipping_cost",
        "invoice_count_current_purchase"
      ]
