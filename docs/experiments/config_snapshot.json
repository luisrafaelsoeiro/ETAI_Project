    ],
    "derived_features": {
      "margin": "net_total - cost",
      "margin_rate": "(net_total - cost) / net_total",
      "discount_rate": "(line_discount_total + global_discount_total) / gross_total",
      "avg_line_value": "net_total / line_item_count",
      "spend_share_30d": "spend_30d / (spend_365d + 1)",
      "spend_share_90d": "spend_90d / (spend_365d + 1)",
      "tax_rate": "total_tax / net_total",
      "overdue_ratio": "days_since_previous_purchase / prior_mean_gap_days",
      "purchase_rate": "prior_purchase_count / (customer_tenure_days + 1)",
      "count_share_90d": "purchase_count_90d / (purchase_count_365d + 1)",
      "ticket_vs_usual": "(net_total + total_tax) / prior_mean_purchase_value",
      "spend_trend": "spend_90d - (spend_180d - spend_90d)",
      "gap_variability": "prior_std_gap_days / prior_mean_gap_days"
    },
    "redundant_columns": [
      "gross_total",
      "total_payable"
    ],
    "almost_empty_preserved_columns": [
      "id",
      "customer_id",
      "repeat_purchase_90d"
    ]
  },
